# Overlay for tests in QEMU only; never pushed to the device.
CONFIG_GARAGE_QEMU=y
CONFIG_ETH_USE_OPENETH=y
# Pull updates from the test harness (plain HTTP, any hour, short delays).
CONFIG_GARAGE_UPDATE_URL="http://10.0.2.2:8000"
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
CONFIG_GARAGE_UPDATE_INTERVAL_S=15
CONFIG_GARAGE_UPDATE_HOUR_FROM=0
CONFIG_GARAGE_UPDATE_HOUR_TO=24
CONFIG_GARAGE_UPDATE_IDLE_S=30
